{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tweakidea.dev/schemas/numbers.json",
  "title": "Numbers",
  "description": "Computed scorecard numbers produced by scripts/compute.py — 100% script-authored, no LLM.",
  "type": "object",
  "required": [
    "weighted_total",
    "potential_total",
    "verdict_bucket",
    "verdict_label",
    "rankings",
    "overall_grade",
    "assumption_impact_math",
    "evidence_totals",
    "reach_potential_blocks"
  ],
  "properties": {
    "weighted_total": {
      "type": "number",
      "minimum": 0,
      "maximum": 5,
      "description": "Weighted average score across all evaluated dimensions."
    },
    "potential_total": {
      "type": "number",
      "minimum": 0,
      "maximum": 5,
      "description": "Weighted average potential score if all unconfirmed assumptions are confirmed."
    },
    "verdict_bucket": {
      "type": "string",
      "enum": ["GO", "PIVOT", "STOP"],
      "description": "Evaluation verdict bucket."
    },
    "verdict_label": {
      "type": "string",
      "description": "Human-readable verdict label."
    },
    "rankings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 14,
      "description": "Per-dimension scores in registry index order.",
      "items": {
        "type": "object",
        "required": ["dim", "slug", "weight", "score", "potential", "weighted_score", "evidence_strength"],
        "properties": {
          "dim": {"type": "string"},
          "slug": {"type": "string"},
          "weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Registry weight as a fraction (e.g. 0.12 for 12%)."
          },
          "score": {
            "type": ["integer", "null"],
            "minimum": 1,
            "maximum": 5
          },
          "potential": {
            "type": ["integer", "null"],
            "minimum": 1,
            "maximum": 5
          },
          "weighted_score": {
            "type": "number",
            "minimum": 0
          },
          "evidence_strength": {
            "type": "object",
            "required": ["both_confirmed", "research_only", "founder_only", "assumed", "grade"],
            "properties": {
              "both_confirmed": {"type": "integer", "minimum": 0},
              "research_only": {"type": "integer", "minimum": 0},
              "founder_only": {"type": "integer", "minimum": 0},
              "assumed": {"type": "integer", "minimum": 0},
              "grade": {
                "type": "string",
                "enum": ["A+", "A", "A-", "B+", "B", "B-", "C", "D", "F"]
              }
            },
            "additionalProperties": false
          },
          "failed": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "overall_grade": {
      "type": "string",
      "enum": ["A+", "A", "A-", "B+", "B", "B-", "C", "D", "F"],
      "description": "Single letter grade summarizing evidence strength across all dimensions."
    },
    "assumption_impact_math": {
      "type": "array",
      "description": "Quantified impact of each unconfirmed assumption on the weighted total.",
      "items": {
        "type": "object",
        "required": ["assumption_text", "dim", "score_delta", "weighted_uplift"],
        "properties": {
          "assumption_text": {"type": "string"},
          "dim": {"type": "string"},
          "score_delta": {"type": "integer"},
          "weighted_uplift": {"type": "number"}
        },
        "additionalProperties": false
      }
    },
    "evidence_totals": {
      "type": "object",
      "required": ["both_confirmed", "research_only", "founder_only", "assumed"],
      "description": "Aggregate evidence tier counts across all valid dimensions. Drives the hero-stats evidence breakdown.",
      "properties": {
        "both_confirmed": {"type": "integer", "minimum": 0},
        "research_only": {"type": "integer", "minimum": 0},
        "founder_only": {"type": "integer", "minimum": 0},
        "assumed": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "reach_potential_blocks": {
      "type": "array",
      "description": "Per-dimension grouping of unconfirmed assumptions, showing the score uplift if confirmed.",
      "items": {
        "type": "object",
        "required": ["dim", "slug", "from", "to", "weighted_uplift", "assumption_texts"],
        "properties": {
          "dim": {"type": "string"},
          "slug": {"type": "string"},
          "from": {"type": "integer", "minimum": 1, "maximum": 5},
          "to": {"type": "integer", "minimum": 1, "maximum": 5},
          "weighted_uplift": {"type": "number"},
          "assumption_texts": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
