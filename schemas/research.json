{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tweakidea.dev/schemas/research.json",
  "title": "Research",
  "description": "Market research clusters produced by ti-researcher, or a stub when research is unavailable.",
  "type": "object",
  "required": ["available"],
  "properties": {
    "available": {
      "type": "boolean",
      "description": "Whether research data was successfully gathered."
    },
    "clusters": {
      "type": "object",
      "description": "Research grouped by USER, COMPETITIVE, and MARKET clusters. Each item is an object with a finding text and an optional source link.",
      "properties": {
        "user": {
          "type": "array",
          "items": {"$ref": "#/$defs/researchItem"}
        },
        "competitive": {
          "type": "array",
          "items": {"$ref": "#/$defs/researchItem"}
        },
        "market": {
          "type": "array",
          "items": {"$ref": "#/$defs/researchItem"}
        }
      },
      "additionalProperties": false
    },
    "competitive_landscape": {
      "type": "array",
      "description": "Structured competitive analysis entries.",
      "items": {
        "type": "object",
        "required": ["competitor", "features", "pricing", "positioning_gap"],
        "properties": {
          "competitor": {"type": "string"},
          "features": {"type": "string"},
          "pricing": {"type": "string"},
          "positioning_gap": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "reason": {
      "type": "string",
      "description": "Explanation when available is false."
    }
  },
  "additionalProperties": false,
  "$defs": {
    "researchItem": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "The research finding or claim text."
        },
        "source_url": {
          "type": "string",
          "description": "Optional URL linking to the source of this finding. Omit for synthesis rows that aggregate across sources."
        },
        "source_title": {
          "type": "string",
          "description": "Optional display label for the source chip (typically the hostname, e.g. 'venturebeat.com'). Omit for synthesis rows."
        }
      },
      "additionalProperties": false
    }
  }
}
